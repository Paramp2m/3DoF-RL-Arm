<!-- arm.xml plus a mocap box ("obstacle") that collides with the arm. Size / pose are set by
     rlarm.envs.obstacle from config (env.box_half) and per episode. -->
<mujoco model="rrr_arm_obstacle">
  <include file="arm.xml"/>
  <worldbody>
    <body name="obstacle" mocap="true" pos="0.3 0.3 0.4">
      <geom name="obstacle" type="box" size="0.04 0.1 0.1" rgba="0.85 0.2 0.2 0.8"/>
    </body>
  </worldbody>
</mujoco>

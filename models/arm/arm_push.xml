<!-- Push variant of arm.xml (phase 5 task E, decision D-1): elbow lower limit -2.2 rad so the tip reaches
     floor height (r 0.24-0.46 m); a round-ended pusher pad on the forearm tip (6 cm dia., a vertical-axis puck when the forearm points down, so it pushes alike in every direction); a free 5 cm cube; the floor marker is the
     mocap "target" at cube-centre height. SPEC §2's "no pose hits the floor" does NOT hold for this model.
     Spatial RRR arm: base yaw (z) -> shoulder pitch -> elbow pitch. Positive pitch raises the link.
     Both actuator sets exist: group 0 = position, group 1 = motor. rlarm.arm.load_model enables one set
     and sets gains, ctrl/force ranges, damping from config. -->
<mujoco model="rrr_arm">
  <compiler angle="radian"/>
  <option timestep="0.002" integrator="implicitfast"/>

  <default>
    <joint damping="0.5" armature="0.01"/>
    <geom rgba="0.25 0.45 0.8 1"/>
  </default>

  <asset>
    <texture name="sky" type="skybox" builtin="gradient" rgb1="0.65 0.78 0.92" rgb2="0.15 0.2 0.3" width="256" height="256"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.82 0.84 0.86" rgb2="0.72 0.74 0.77" width="256" height="256"/>
    <material name="floor" texture="grid" texrepeat="6 6" reflectance="0.05"/>
  </asset>

  <worldbody>
    <light pos="0.5 -0.5 2" dir="-0.2 0.2 -1" diffuse="0.9 0.9 0.9"/>
    <geom name="floor" type="plane" size="1.5 1.5 0.05" material="floor" rgba="1 1 1 1"/>
    <camera name="main" pos="1.1 -1.1 0.7" xyaxes="0.757 0.654 0 -0.205 0.237 0.95"/>

    <body name="base">
      <geom name="column" type="cylinder" fromto="0 0 0 0 0 0.06" size="0.04" rgba="0.3 0.3 0.33 1"/>
      <body name="shoulder" pos="0 0 0.10">
        <joint name="yaw" type="hinge" axis="0 0 1" range="-3.1 3.1"/>
        <geom name="housing" type="sphere" size="0.035" mass="0.8" rgba="0.3 0.3 0.33 1"/>
        <body name="upper_arm">
          <joint name="shoulder_pitch" type="hinge" axis="0 -1 0" range="0.4 1.7"/>
          <geom name="upper_arm" type="capsule" fromto="0 0 0 0.30 0 0" size="0.025" mass="1.0"/>
          <body name="forearm" pos="0.30 0 0">
            <joint name="elbow_pitch" type="hinge" axis="0 -1 0" range="-2.2 1.4"/>
            <geom name="forearm" type="capsule" fromto="0 0 0 0.25 0 0" size="0.02" mass="0.6" rgba="0.85 0.5 0.2 1"/>
            <geom name="pad" type="cylinder" fromto="0.20 0 0 0.265 0 0" size="0.03" mass="0.05" rgba="0.9 0.3 0.2 1"/>
            <site name="tip" pos="0.25 0 0" size="0.012" rgba="1 0.2 0.2 1"/>
          </body>
        </body>
      </body>
    </body>

    <body name="cube" pos="0.35 0 0.025">
      <freejoint name="cube_free"/>
      <geom name="cube" type="box" size="0.025 0.025 0.025" mass="0.1" friction="0.5 0.005 0.0001" rgba="0.95 0.8 0.2 1"/>
    </body>

    <body name="target" mocap="true" pos="0.3 0 0.025">
      <geom name="target" type="cylinder" size="0.03 0.002" contype="0" conaffinity="0" rgba="0.2 0.9 0.3 0.6"/>
    </body>
  </worldbody>

  <actuator>
    <position name="yaw_pos" joint="yaw" group="0"/>
    <position name="shoulder_pos" joint="shoulder_pitch" group="0"/>
    <position name="elbow_pos" joint="elbow_pitch" group="0"/>
    <motor name="yaw_motor" joint="yaw" group="1"/>
    <motor name="shoulder_motor" joint="shoulder_pitch" group="1"/>
    <motor name="elbow_motor" joint="elbow_pitch" group="1"/>
  </actuator>
</mujoco>
